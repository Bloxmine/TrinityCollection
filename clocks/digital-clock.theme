karamba:theme
{
	layer: onbottom
	hidden: false
	locked: false
	ontop: false
	sticky: false
	x: 50
	y: 200
	w: 280
	h: 100
	
	theme file: digital-clock.py
	interval: 1000
	
	text {
		x: 10
		y: 10
		w: 260
		h: 40
		font: Arial
		fontsize: 24
		color: 0,255,100
		shadow: 2
		value: "00:00:00"
		name: time_display
		alignment: center
	}
	
	text {
		x: 10
		y: 55
		w: 260
		h: 20
		font: Arial
		fontsize: 14
		color: 200,200,255
		shadow: 1
		value: "Monday, January 1, 2024"
		name: date_display
		alignment: center
	}
	
	text {
		x: 10
		y: 75
		w: 260
		h: 15
		font: Arial
		fontsize: 10
		color: 150,150,150
		value: "24-hour format"
		name: format_display
		alignment: center
	}
}