karamba:theme
{
	layer: onbottom
	hidden: false
	locked: false
	ontop: false
	sticky: false
	x: 350
	y: 200
	w: 150
	h: 150
	
	theme file: analog-clock.py
	interval: 1000
	
	# Clock face background circle
	polygon {
		x: 75
		y: 75
		linewidth: 2
		color: 100,100,100
		fillcolor: 30,30,30
		name: clock_face
	}
	
	# Hour markers
	text {
		x: 68
		y: 10
		w: 14
		h: 14
		font: Arial
		fontsize: 12
		color: 255,255,255
		value: "12"
		name: hour_12
		alignment: center
	}
	
	text {
		x: 128
		y: 68
		w: 14
		h: 14
		font: Arial
		fontsize: 12
		color: 255,255,255
		value: "3"
		name: hour_3
		alignment: center
	}
	
	text {
		x: 68
		y: 125
		w: 14
		h: 14
		font: Arial
		fontsize: 12
		color: 255,255,255
		value: "6"
		name: hour_6
		alignment: center
	}
	
	text {
		x: 8
		y: 68
		w: 14
		h: 14
		font: Arial
		fontsize: 12
		color: 255,255,255
		value: "9"
		name: hour_9
		alignment: center
	}
	
	# Center dot
	polygon {
		x: 75
		y: 75
		linewidth: 1
		color: 255,255,255
		fillcolor: 255,255,255
		name: center_dot
	}
}