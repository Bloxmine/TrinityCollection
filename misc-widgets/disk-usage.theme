karamba:theme
{
	layer: onbottom
	hidden: false
	locked: false
	ontop: false
	sticky: false
	x: 50
	y: 520
	w: 320
	h: 160
	
	theme file: disk-usage.py
	interval: 10000
	
	text {
		x: 10
		y: 10
		w: 300
		h: 20
		font: Arial
		fontsize: 14
		color: 255,255,255
		shadow: 1
		value: "Disk Usage Monitor"
	}
	
	text {
		x: 10
		y: 35
		w: 300
		h: 15
		font: Arial
		fontsize: 12
		color: 255,200,100
		value: "/ (root): 0.0GB / 0.0GB (0%)"
		name: root_usage
	}
	
	bar {
		x: 10
		y: 55
		w: 300
		h: 12
		min: 0
		max: 100
		value: 0
		name: root_bar
		color: 255,100,100
	}
	
	text {
		x: 10
		y: 75
		w: 300
		h: 15
		font: Arial
		fontsize: 12
		color: 100,255,200
		value: "/home: 0.0GB / 0.0GB (0%)"
		name: home_usage
	}
	
	bar {
		x: 10
		y: 95
		w: 300
		h: 12
		min: 0
		max: 100
		value: 0
		name: home_bar
		color: 100,255,100
	}
	
	text {
		x: 10
		y: 115
		w: 300
		h: 15
		font: Arial
		fontsize: 11
		color: 200,200,255
		value: "Total: 0 filesystems monitored"
		name: summary_display
	}
	
	text {
		x: 10
		y: 135
		w: 300
		h: 15
		font: Arial
		fontsize: 9
		color: 150,150,150
		value: "Last updated: Never"
		name: last_update
	}
}